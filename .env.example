# Local: Gemini orchestrator (talks to you, assigns agents)
ORCH_PROVIDER=gemini
ORCH_MODEL=gemini-3.6-flash
GEMINI_API_KEY=

# Domain agents: local Ollama coder (SQL only — does not talk to the user)
AGENT_PROVIDER=ollama
AGENT_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_HOST=http://host.docker.internal:11434
INSIGHT_NARRATE=template

# Legacy aliases (optional). Do not set LLM_PROVIDER=gemini — that used to
# send the SQL loop to Gemini and burn quota.
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
