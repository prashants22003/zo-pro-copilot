# NVIDIA NIM orchestrator + SQL agents (Gemini optional)
ORCH_PROVIDER=nvidia
ORCH_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
GEMINI_API_KEY=
# NVIDIA NIM SQL agents
AGENT_PROVIDER=nvidia
AGENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
INSIGHT_NARRATE=template
# Supabase session pooler (port 5432, user is role.PROJECTREF, sslmode=require)
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SALES_DATABASE_URL=postgresql://sales_agent_role.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
PURCHASE_DATABASE_URL=postgresql://purchase_agent_role.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
INSIGHT_DATABASE_URL=postgresql://insight_role.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Local origins; add https://YOUR-APP.vercel.app after Vercel deploy
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173
# Vercel only (leave unset locally so /api still proxies)
# VITE_API_BASE_URL=https://YOUR-API.onrender.com
